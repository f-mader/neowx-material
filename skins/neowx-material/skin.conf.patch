[Generators]
    generator_list = weewx.reportengine.CopyGenerator, user.neowx_archive.NeowxArchiveGenerator
[Extras]
  [[Header]]
    description = Wetterstation der Sternwarte Schönberg
    keywords = weather,weewx,schönberg,wetter,sternwarte,gsp

  [[Footer]]
    name = Wetterstation der GSP Schönberg
    link1_label = GSP Sternwarte
    link1_url = https://www.gsp-sternwarte.de
    link2_label = GSP Schönberg
    link2_url = https://www.gsp-schoenberg.de
    imprint_label = Impressum
    imprint_url = https://gsp-schoenberg.de/impressum/
    privacy_label = Datenschutzerklärung
    privacy_url = https://gsp-schoenberg.de/datenschutz/

  [[Appearance]]
    # A patch section merges INTO the shipped section with the same id; it
    # does not replace the section, and it cannot delete it. Reuse one of the
    # nine shipped [[[sections]]] ids to override its items/title/etc.:
    # card, external_sensors, chart, custom_charts, additional_charts,
    # external_sensor_charts, other_charts, telemetry_cards, telemetry_charts.
    #
    # A section id that ISN'T one of those (like "main" below in an older
    # version of this sample) is instead APPENDED after the shipped sections,
    # and every one of its items gets de-duplicated away by whichever shipped
    # section already claims them.
    #
    # To hide a shipped panel, override its items with an empty value - a
    # section with no items never renders:
    #     [[[[external_sensors]]]]
    #         items =
    #
    # See docs/CONFIG-PATCHER.md for the full explanation.
    #
    # IMPORTANT: keep [[[sections]]] LAST inside [[Appearance]], here and in
    # skin.conf.  It is a subsection, so configobj treats every plain setting
    # written below it as belonging to whichever [[[[...]]]] block came last.
    # A setting that lands there silently stops working, and panelorder logs
    # it as an 'unknown setting' on that section.
    #
    # Here we override the shipped "card" section's item order/selection,
    # and add a brand-new "embedded" section containing an embedded item:
    [[[pages]]]
      [[[[today]]]]
        sections = cards, charts
       [[[[year]]]]
        sections = cards, charts
    [[[sections]]]
      [[[[cards]]]]
        items = outTemp, outHumidity, barometer, windSpeed, windrun, rain, inTemp, inHumidity, dewpoint, appTemp, cloudbase, forecast
      [[[[external_sensors]]]]
        items =
      [[[[external_sensors_cards]]]]
        items =
      [[[[additional_cards]]]]
        items =
      [[[[additional_charts]]]]
        items =
      [[[[embedded_items]]]]
       items =
    [[[[charts]]]]
        title = Verläufe
        items = outTemp, outHumidity, barometer, rain, inTemp, inHumidity, windSpeed, windDir, windvec, windrun, cloudbase
        content = chart


  [[Forecast]]
    variables = temperature, precipitation, uv-sun, wind, evapotranspiration
    forecast_separator = yes
    show_today_tomorrow = yes
    show_hourly_icons = yes

  [[OnlineCheck]]
        # URL to check for connectivity. Default: http://www.google.com
        check_url = http://www.ddg.com

        # Timeout for the check in seconds. Default: 10
        timeout = 10

        # Interval for the check in minutes. Default: 3
        interval = 60

        # Always show online status icon. Default: false
        always_show_status = false
  [[Charts]]  
    [[[Titles]]]
      inTemp = "Sternwartentemperatur"
      inHumidity = "Sternwartenluftfeuchte"
[HistoryReport]
  monthnames = Jan., Feb., Mär., Apr., Mai, Juni, Juli, Aug., Sept., Okt., Nov., Dez.
